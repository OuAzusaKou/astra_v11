/build/
/dist/
*.egg-info/

# Local credentials and environment overrides
.env
.env.*
!.env.example
!.env.sample
.secrets/

# Editor and OS temporary files
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

