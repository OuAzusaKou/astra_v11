/outputs/
/logs/
/recordings/
/data/reference_videos/
*.log

# Python bytecode, environments and tooling caches
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

